# Public browser configuration. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical public origin, used for OAuth redirects and profile links.
VITE_APP_URL=http://localhost:3000

# Optional client-side observability.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
VITE_APPLE_PAY_ENABLED=false

# Server-only Supabase Edge Function secrets (set with `supabase secrets set`).
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# APP_URL=https://ushqn.kz
