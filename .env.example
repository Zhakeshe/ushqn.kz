# Public browser configuration. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical public origin, used for OAuth redirects and profile links.
VITE_APP_URL=http://localhost:3000

# Optional client-side observability.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
VITE_APPLE_WALLET_ENABLED=false

# Server-only Apple Wallet signing settings (set with `supabase secrets set`).
# APPLE_PASS_TYPE_IDENTIFIER=pass.kz.ushqn.student
# APPLE_TEAM_IDENTIFIER=
# APPLE_PASS_SIGNER_CERT_PEM=
# APPLE_PASS_SIGNER_KEY_PEM=
# APPLE_WWDR_CERT_PEM=
# APPLE_PASS_ICON_PNG_BASE64=
# APP_URL=https://ushqn.kz
